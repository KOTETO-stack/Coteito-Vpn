{
  "project": {
    "name": "Karing Auto VPN",
    "language": "ru",
    "max_nodes": 150,
    "min_nodes": 50
  },
  "sources": {
    "min_sources": 100,
    "allow_telegram": false,
    "allow_private_sources": false,
    "timeout_seconds": 20
  },
  "protocols": {
    "allowed": [
      "hysteria2",
      "hy2",
      "trojan"
    ],
    "prefer": [
      "hysteria2",
      "trojan"
    ]
  },
  "testing": {
    "tcp_connect_timeout_ms": 5000,
    "tls_timeout_ms": 7000,
    "ping_timeout_ms": 3000,
    "dns_timeout_ms": 5000,
    "max_latency_ms": 1500,
    "max_packet_loss_percent": 20,
    "require_tls": true,
    "verify_tls_certificate": true,
    "test_dns_leak": true
  },
  "scoring": {
    "latency_weight": 40,
    "packet_loss_weight": 20,
    "availability_weight": 25,
    "tls_weight": 10,
    "protocol_weight": 5
  },
  "node_naming": {
    "format": "{flag} {country} {city}",
    "fallback_city": "Неизвестный город",
    "fallback_country": "Неизвестная страна"
  },
  "update": {
    "interval_minutes": 60,
    "publish_only_if_valid": true,
    "keep_previous_on_failure": true
  },
  "routing": {
    "russia": "direct",
    "foreign": "proxy",
    "unknown": "direct",
    "block_ads": true,
    "block_trackers": true
  },
  "services": {
    "youtube": "proxy",
    "telegram": "proxy",
    "tiktok": "proxy",
    "whatsapp": "proxy",
    "wechat": "proxy",
    "bip": "proxy"
  },
  "dns": {
    "enabled": true,
    "prevent_leaks": true,
    "prefer_ipv4": true,
    "remove_client_subnet": true
  },
  "warp": {
    "enabled": true,
    "use_only_public_configs": true,
    "validate_before_publish": true
  },
  "amneziafree": {
    "enabled": true,
    "use_only_public_configs": true,
    "validate_before_publish": true
  },
  "security": {
    "reject_invalid_urls": true,
    "reject_private_ips": true,
    "reject_localhost": true,
    "reject_invalid_tls": true,
    "reject_expired_certificates": true,
    "reject_duplicate_nodes": true,
    "sanitize_node_names": true
  }
}